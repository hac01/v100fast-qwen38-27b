+    void s9_dyn_reset(llama_seq_id seq_id) {
+        if (seq_id >= 0 && seq_id < (llama_seq_id) s9_last_pos0.size()) {
+            s9_last_pos0[seq_id]  = -1;
+            s9_cur_ndraft[seq_id] = 7;
+            s9_low_streak[seq_id] = 0;
+        }
+    }
+
+    int32_t s9_choose_ndraft(llama_seq_id seq_id, int32_t pos0) {
+        static const int s9_dyn_block = []() {
+            const char * e = std::getenv("LLAMA_SM70_DYN_BLOCK");
+            return e ? std::atoi(e) : 0;
+        }();
+        static const int s9_dyn_up = []() {
+            const char * e = std::getenv("LLAMA_SM70_DYN_UP");
+            return (e && std::atoi(e) > 0) ? std::atoi(e) : 7;
+        }();
+        static const int s9_dyn_down = []() {
+            const char * e = std::getenv("LLAMA_SM70_DYN_DOWN");
+            return (e && std::atoi(e) > 0) ? std::atoi(e) : 6;
+        }();
+        static const int s9_dyn_min = []() {
+            const char * e = std::getenv("LLAMA_SM70_DYN_MIN");
+            const int v = e ? std::atoi(e) : 7;
+            return (v >= 3 && v <= 15) ? v : 7;
+        }();
+        if (s9_dyn_block <= 0 || params.n_max <= s9_dyn_min) {
+            return params.n_max;
+        }
+        if ((size_t) seq_id >= s9_last_pos0.size()) {
+            s9_last_pos0.resize(seq_id + 1, -1);
+            s9_cur_ndraft.resize(seq_id + 1, s9_dyn_min);
+            s9_low_streak.resize(seq_id + 1, 0);
+        }
+        const int32_t prev_pos = s9_last_pos0[seq_id];
+        if (prev_pos >= 0 && pos0 > prev_pos) {
+            const int32_t last_acc = (pos0 - prev_pos) - 1;
+            if (s9_cur_ndraft[seq_id] <= s9_dyn_min) {
+                if (last_acc >= s9_dyn_up) {
+                    s9_cur_ndraft[seq_id] = params.n_max;
+                    s9_low_streak[seq_id] = 0;
+                }
+            } else {
+                if (last_acc < s9_dyn_down) {
+                    static const int s9_dyn_streak = []() { const char * e = std::getenv("LLAMA_SM70_DYN_STREAK"); return (e && std::atoi(e) > 0) ? std::atoi(e) : 1; }();
+                    if (++s9_low_streak[seq_id] >= s9_dyn_streak) {
+                        s9_cur_ndraft[seq_id] = s9_dyn_min;
+                        s9_low_streak[seq_id] = 0;
