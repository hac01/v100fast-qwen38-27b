+#pragma unroll
+    for (int r = 0; r < n_vec4; ++r) {
+        s4[r] = curr_s4[r * 8 + lane_in_col];
+    }
+
+    if (do_replay) {
+        const int n_replay = meta.prev_n - rs_idx;
+        const float * rk_base = rep_k    + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H_k * S_v) + (int64_t) iq1 * S_v;
+        const float * rv_base = rep_v    + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H   * S_v) + (int64_t) h_idx * S_v;
+        const float * rg_base = rep_g    + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H) + h_idx;
+        const float * rb_base = rep_beta + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H) + h_idx;
+
+        for (int t = 0; t < n_replay; ++t) {
+            const float4 * k_t4 = reinterpret_cast<const float4 *>(rk_base + (int64_t) t * H_k * S_v);
+            const float *  v_t  = rv_base + (int64_t) t * H * S_v;
+            const float    g_val    = rg_base[(int64_t) t * H];
+            const float    beta_val = rb_base[(int64_t) t * H];
+
+            float4 k4[n_vec4];
+            float kv_shard = 0.0f;
+#pragma unroll
+            for (int r = 0; r < n_vec4; ++r) {
+                k4[r] = k_t4[r * 8 + lane_in_col];
+                kv_shard += s4[r].x * k4[r].x + s4[r].y * k4[r].y + s4[r].z * k4[r].z + s4[r].w * k4[r].w;
+            }
+            const float kv_col    = warp_reduce_sum<lanes_per_col>(kv_shard);
+            const float delta_col = (v_t[col] - g_val * kv_col) * beta_val;
+#pragma unroll
+            for (int r = 0; r < n_vec4; ++r) {
+                s4[r].x = g_val * s4[r].x + k4[r].x * delta_col;
+                s4[r].y = g_val * s4[r].y + k4[r].y * delta_col;
+                s4[r].z = g_val * s4[r].z + k4[r].z * delta_col;
+                s4[r].w = g_val * s4[r].w + k4[r].w * delta_col;
+            }
+        }
+    }
+
+    float4 * out_s4 = reinterpret_cast<float4 *>(dst_s0 + col_off);
+#pragma unroll
+    for (int r = 0; r < n_vec4; ++r) {
+        out_s4[r * 8 + lane_in_col] = s4[r];
+    }
+}
+
+// Kernel 4: Materialize a specific (cell_id, rs_idx) slot into ssm_base (for state_write / unmatched GET_ROWS)
+__global__ void __launch_bounds__(128, 2)
+gdn_materialize_slot_cuda(
+        float * __restrict__           ssm_base,
+        const float * __restrict__     rep_k,
+        const float * __restrict__     rep_v,
+        const float * __restrict__     rep_g,
+        const float * __restrict__     rep_beta,
+        const gdn_replay_meta * __restrict__ rep_meta,
+        int64_t H,
+        int64_t H_k,
+        int64_t mem_size,
+        int32_t cell_id,
+        int32_t rs_idx,
+        const int32_t * __restrict__ d_s_copy_opt,
+        const uint3 neqk1_magic) {
+    constexpr int S_v           = 128;
+    constexpr int cols_per_warp = 4;
+    constexpr int lanes_per_col = 8;
+    constexpr int n_vec4        = 4;
+
+    if (d_s_copy_opt != nullptr) {
+        const int32_t v = d_s_copy_opt[0];
+        rs_idx  = v / (int32_t) mem_size;
+        cell_id = v - rs_idx * (int32_t) mem_size;
+    }
+
+    if (rs_idx <= 0 || cell_id < 0 || cell_id >= mem_size) {
+        return;
+    }
+    const gdn_replay_meta meta = rep_meta[cell_id];
+    if (meta.valid == 0 || rs_idx >= meta.prev_n) {
+        return;
+    }
+
+    const uint32_t h_idx       = blockIdx.x;
+    const int      lane        = threadIdx.x;
+    const int      col_in_warp = lane / lanes_per_col;
+    const int      lane_in_col = lane - col_in_warp * lanes_per_col;
+    const int      col         = (blockIdx.z * blockDim.y + threadIdx.y) * cols_per_warp + col_in_warp;
+    const uint32_t iq1         = fastmodulo(h_idx, neqk1_magic);
+
+    const int64_t D       = H * (int64_t)(S_v * S_v);
+    const int64_t col_off = ((int64_t) h_idx * S_v + col) * S_v;
+
+    const float4 * curr_s4 = reinterpret_cast<const float4 *>(
+        ssm_base + (1 * mem_size + cell_id) * D + col_off);
+    float4 s4[n_vec4];
+#pragma unroll
+    for (int r = 0; r < n_vec4; ++r) {
+        s4[r] = curr_s4[r * 8 + lane_in_col];
+    }
+
+    const int n_replay = meta.prev_n - rs_idx;
+    const float * rk_base = rep_k    + (int64_t) cell_id * (GDN_REPLAY_MAX_T * H_k * S_v) + (int64_t) iq1 * S_v;
+    const float * rv_base = rep_v    + (int64_t) cell_id * (GDN_REPLAY_MAX_T * H   * S_v) + (int64_t) h_idx * S_v;
+    const float * rg_base = rep_g    + (int64_t) cell_id * (GDN_REPLAY_MAX_T * H) + h_idx;
+    const float * rb_base = rep_beta + (int64_t) cell_id * (GDN_REPLAY_MAX_T * H) + h_idx;
+
+    for (int t = 0; t < n_replay; ++t) {
+        const float4 * k_t4 = reinterpret_cast<const float4 *>(rk_base + (int64_t) t * H_k * S_v);
+        const float *  v_t  = rv_base + (int64_t) t * H * S_v;
+        const float    g_val    = rg_base[(int64_t) t * H];
+        const float    beta_val = rb_base[(int64_t) t * H];
+
+        float4 k4[n_vec4];
+        float kv_shard = 0.0f;
+#pragma unroll
+        for (int r = 0; r < n_vec4; ++r) {
+            k4[r] = k_t4[r * 8 + lane_in_col];
+            kv_shard += s4[r].x * k4[r].x + s4[r].y * k4[r].y + s4[r].z * k4[r].z + s4[r].w * k4[r].w;
+        }
+        const float kv_col    = warp_reduce_sum<lanes_per_col>(kv_shard);
+        const float delta_col = (v_t[col] - g_val * kv_col) * beta_val;
+#pragma unroll
+        for (int r = 0; r < n_vec4; ++r) {
+            s4[r].x = g_val * s4[r].x + k4[r].x * delta_col;
+            s4[r].y = g_val * s4[r].y + k4[r].y * delta_col;
+            s4[r].z = g_val * s4[r].z + k4[r].z * delta_col;
+            s4[r].w = g_val * s4[r].w + k4[r].w * delta_col;
+        }
+    }
+
+    float4 * dst_s4 = reinterpret_cast<float4 *>(
+        ssm_base + ((int64_t) rs_idx * mem_size + cell_id) * D + col_off);
+#pragma unroll
+    for (int r = 0; r < n_vec4; ++r) {
+        dst_s4[r * 8 + lane_in_col] = s4[r];
+    }
+}
+
+__global__ void gdn_invalidate_meta_cuda(
+        gdn_replay_meta * __restrict__ rep_meta,
+        int64_t mem_size,
+        int32_t cell_id,
+        const int32_t * __restrict__ d_s_copy_opt) {
+    if (d_s_copy_opt != nullptr) {
+        const int32_t v = d_s_copy_opt[0];
+        const int32_t rs_idx = v / (int32_t) mem_size;
+        cell_id = v - rs_idx * (int32_t) mem_size;
+        if (rs_idx <= 0) {
+            return;
+        }
+    }
+    if (cell_id >= 0 && cell_id < mem_size) {
+        rep_meta[cell_id].valid  = 0;
+        rep_meta[cell_id].prev_n = 0;
+    }
+}
+
+void ggml_cuda_op_gated_delta_net_replay(
+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_cuda_gdn_replay_direct & direct) {
+    ggml_tensor * src_q     = dst->src[0];
+    ggml_tensor * src_k     = dst->src[1];
+    ggml_tensor * src_v     = dst->src[2];
+    ggml_tensor * src_g     = dst->src[3];
+    ggml_tensor * src_beta  = dst->src[4];
+    ggml_tensor * src_state = dst->src[5];
+
+    GGML_TENSOR_LOCALS(int64_t, neq, src_q, ne);
+    GGML_TENSOR_LOCALS(size_t,  nbq, src_q, nb);
+    GGML_TENSOR_LOCALS(int64_t, nev, src_v, ne);
+    GGML_TENSOR_LOCALS(size_t,  nbv, src_v, nb);
+    GGML_TENSOR_LOCALS(size_t,  nbb, src_beta, nb);
+
+    const int64_t S_v      = nev0;
+    const int64_t H        = nev1;
+    const int64_t H_k      = neq1;
+    const int64_t n_tokens = nev2;
+
+    gdn_replay_entry entry{};
+    const bool found = gdn_replay_lookup(direct.ssm_base, entry);
+    GGML_ASSERT(found);
+
+    const float * q_d    = (const float *) src_q->data;
+    const float * k_d    = (const float *) src_k->data;
+    const float * v_d    = (const float *) src_v->data;
+    const float * g_d    = (const float *) src_g->data;
+    const float * b_d    = (const float *) src_beta->data;
+    float *       dst_d  = (float *)       dst->data;
+
+    const int64_t sq1 = nbq1 / sizeof(float);
+    const int64_t sq2 = nbq2 / sizeof(float);
+    const int64_t sv1 = nbv1 / sizeof(float);
+    const int64_t sv2 = nbv2 / sizeof(float);
+    const int64_t sb1 = nbb1 / sizeof(float);
+    const int64_t sb2 = nbb2 / sizeof(float);
+    const float   scale = 1.0f / sqrtf((float) S_v);
+
+    cudaStream_t stream = ctx.stream();
+    const uint3 neqk1_magic = init_fastdiv_values((uint32_t) H_k);
+
+    dim3 grid_dims((uint32_t) H, 1, (uint32_t)(S_v / 16)); // 48, 1, 8
+    dim3 block_dims(32, 4, 1);
+
+    if (n_tokens <= GDN_REPLAY_MAX_T) {
+        ggml_cuda_kernel_launch(gated_delta_net_replay_cuda,
+            ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, stream),
+            q_d, k_d, v_d, g_d, b_d, dst_d,
+            direct.ssm_base, direct.d_s_copy,
+            entry.d_k, entry.d_v, entry.d_g, entry.d_beta, entry.d_meta,
+            H, H_k, n_tokens, direct.mem_size, direct.dst_cell,
+            sq1, sq2, sv1, sv2, sb1, sb2, neqk1_magic, scale);
+
+        const uint32_t save_blocks  = (n_tokens > 1) ? 128u : 1u;
+        const uint32_t save_threads = (n_tokens > 1) ? 256u : 1u;
+        gdn_save_replay_cuda<<<save_blocks, save_threads, 0, stream>>>(
+            k_d, v_d, g_d, b_d,
+            entry.d_k, entry.d_v, entry.d_g, entry.d_beta, entry.d_meta,
+            H, H_k, n_tokens, direct.dst_cell,
+            sq1, sq2, sv1, sv2, sb1, sb2);
+        return;
+    }
+
+    // Prefill (n_tokens > GDN_REPLAY_MAX_T): resolve exact starting state into src_state->data,
+    // invalidate replay meta for dst_cell, then run standard chunked prefill + materialized snapshots.
+    float * s0_scratch = (float *) src_state->data;
+    gdn_resolve_state_for_prefill_cuda<<<grid_dims, block_dims, 0, stream>>>(
+        direct.ssm_base, direct.d_s_copy, s0_scratch,
+        entry.d_k, entry.d_v, entry.d_g, entry.d_beta, entry.d_meta,
+        H, H_k, direct.mem_size, neqk1_magic);
+    gdn_invalidate_meta_cuda<<<1, 1, 0, stream>>>(
+        entry.d_meta, direct.mem_size, (int32_t) direct.dst_cell, nullptr);
+
+    ggml_cuda_op_gated_delta_net_impl(ctx, dst, &direct.cache, nullptr);
+}
+
+void ggml_cuda_gdn_replay_on_unmatched_get_rows(ggml_backend_cuda_context & ctx, const ggml_tensor * get_rows) {
+    if (!g_gdn_replay_active.load(std::memory_order_acquire)) {
+        return;
+    }
+    const ggml_tensor * base = get_rows->src[0];
+    while (base && base->view_src) {
+        base = base->view_src;
+    }
+    if (!base || base->data == nullptr) {
+        return;
+    }
+    gdn_replay_entry entry{};
+    if (!gdn_replay_lookup(base->data, entry)) {
+        return;
+    }
+    const ggml_tensor * ids = get_rows->src[1];
+    if (!ids || ids->type != GGML_TYPE_I32 || ids->data == nullptr) {
+        return;
+    }
+    const int64_t n_ids = ggml_nelements(ids);
+    const int32_t * d_ids = (const int32_t *) ids->data;
+    cudaStream_t stream = ctx.stream();
+    const uint3 neqk1_magic = init_fastdiv_values((uint32_t) entry.H_k);
+    dim3 grid_dims((uint32_t) entry.H_v, 1, (uint32_t)(entry.S_v / 16));
+    dim3 block_dims(32, 4, 1);
+
+    for (int64_t k = 0; k < n_ids; ++k) {
+        gdn_materialize_slot_cuda<<<grid_dims, block_dims, 0, stream>>>(
+            entry.ssm_base, entry.d_k, entry.d_v, entry.d_g, entry.d_beta, entry.d_meta,
+            entry.H_v, entry.H_k, entry.mem_size, 0, 0, d_ids + k, neqk1_magic);
+        gdn_invalidate_meta_cuda<<<1, 1, 0, stream>>>(
+            entry.d_meta, entry.mem_size, 0, d_ids + k);
+    }
+}
+
+void ggml_cuda_gdn_replay_on_tensor_read(const void * tensor_data, size_t offset, size_t size, int device) {
+    if (!g_gdn_replay_active.load(std::memory_order_acquire) || size == 0) {
+        return;
+    }
+    gdn_replay_entry entry{};
+    if (!gdn_replay_lookup(tensor_data, entry)) {
+        return;
+    }
+    const size_t row_bytes = (size_t) entry.D * sizeof(float);
+    const size_t slot0_end = (size_t) entry.mem_size * row_bytes;
+    if (offset + size <= slot0_end) {
+        return;
+    }
+
+    ggml_cuda_set_device(device);
+    const uint3 neqk1_magic = init_fastdiv_values((uint32_t) entry.H_k);
+    dim3 grid_dims((uint32_t) entry.H_v, 1, (uint32_t)(entry.S_v / 16));
+    dim3 block_dims(32, 4, 1);
+
+    const size_t first_row = offset / row_bytes;
+    const size_t last_row  = (offset + size - 1) / row_bytes;
+    for (size_t row = first_row; row <= last_row; ++row) {
+        const int32_t rs_idx  = (int32_t)(row / (size_t) entry.mem_size);
+        const int32_t cell_id = (int32_t)(row % (size_t) entry.mem_size);
+        if (rs_idx <= 0 || rs_idx >= entry.K_max) {
+            continue;
+        }
+        gdn_materialize_slot_cuda<<<grid_dims, block_dims, 0, cudaStreamPerThread>>>(
+            entry.ssm_base, entry.d_k, entry.d_v, entry.d_g, entry.d_beta, entry.d_meta,
+            entry.H_v, entry.H_k, entry.mem_size, cell_id, rs_idx, nullptr, neqk1_magic);
+        gdn_invalidate_meta_cuda<<<1, 1, 0, cudaStreamPerThread>>>(
+            entry.d_meta, entry.mem_size, cell_id, nullptr);
+    }
+}
+
+void ggml_cuda_gdn_replay_on_tensor_write(const void * tensor_data, int device) {
+    if (!g_gdn_replay_active.load(std::memory_order_acquire)) {
+        return;
+    }
+    gdn_replay_entry entry{};
+    if (!gdn_replay_lookup(tensor_data, entry)) {
+        return;
+    }
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaMemsetAsync(entry.d_meta, 0, (size_t) entry.mem_size * sizeof(gdn_replay_meta), cudaStreamPerThread));
+}
+
+void ggml_cuda_gdn_replay_on_buffer_clear(const void * buffer, int device) {
+    if (!g_gdn_replay_active.load(std::memory_order_acquire)) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_gdn_replay_mtx);
+    ggml_cuda_set_device(device);
+    for (auto & kv : g_gdn_replay_map) {
+        if (kv.second.ssm_buffer == buffer) {
+            CUDA_CHECK(cudaMemsetAsync(kv.second.d_meta, 0, (size_t) kv.second.mem_size * sizeof(gdn_replay_meta), cudaStreamPerThread));
+        }
+    }
+}
+
+void ggml_cuda_gdn_replay_on_buffer_free(const void * buffer) {
+    if (!g_gdn_replay_active.load(std::memory_order_acquire)) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_gdn_replay_mtx);
+    for (auto it = g_gdn_replay_map.begin(); it != g_gdn_replay_map.end(); ) {
+        if (it->second.ssm_buffer == buffer) {
+            ggml_cuda_set_device(it->second.device);
+            CUDA_CHECK(cudaFree(it->second.d_alloc));
+            it = g_gdn_replay_map.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    if (g_gdn_replay_map.empty()) {
+        g_gdn_replay_active.store(false, std::memory_order_release);
+    }
 }
