+
+// ============================================================================
+// Phase 6E Option 2: Exact FP32 GDN Direct-State + Rollback Replay-from-s0
+// ============================================================================
+// Controlled by LLAMA_SM70_GDN_REPLAY=1 (opt-in until verified).
+// Eliminates k_get_rows_float_vec (0.58 ms/step) and 14/16 redundant FP32
+// rollback snapshot writes (~2.11 GB/step) on n_tokens <= 16, K > 1, n_seqs == 1.
+
+static constexpr int GDN_REPLAY_MAX_T = 16;
+
+struct gdn_replay_meta {
+    int32_t valid;   // 1 = slot 1 + replay buf hold exact rollback state; 0 = slots materialized
+    int32_t prev_n;  // number of tokens saved in replay buffer (2..GDN_REPLAY_MAX_T)
+};
+
+struct gdn_replay_entry {
+    int     device;
+    void *  ssm_buffer;
+    float * ssm_base;
+    int64_t D;
+    int64_t S_v;
+    int64_t H_v;
+    int64_t H_k;
+    int64_t mem_size;
+    int64_t K_max;
+    void *  d_alloc;
+    float * d_k;
+    float * d_v;
+    float * d_g;
+    float * d_beta;
+    gdn_replay_meta * d_meta;
+};
+
+static std::mutex g_gdn_replay_mtx;
+static std::unordered_map<const void *, gdn_replay_entry> g_gdn_replay_map;
+static std::atomic<bool> g_gdn_replay_active{false};
+
+bool ggml_cuda_gdn_replay_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("LLAMA_SM70_GDN_REPLAY");
+        return e && e[0] == '1';
+    }();
+    return enabled;
+}
+
+static size_t gdn_align256(size_t n) {
+    return (n + 255) & ~size_t(255);
+}
+
+void ggml_cuda_gdn_replay_ensure_entry(
+        int device, void * ssm_buffer, float * ssm_base,
+        int64_t S_v, int64_t H_v, int64_t H_k, int64_t mem_size, int64_t K_max) {
+    std::lock_guard<std::mutex> lock(g_gdn_replay_mtx);
+    auto it = g_gdn_replay_map.find(ssm_base);
+    if (it != g_gdn_replay_map.end()) {
+        if (it->second.device == device && it->second.ssm_buffer == ssm_buffer &&
+            it->second.S_v == S_v && it->second.H_v == H_v && it->second.H_k == H_k &&
+            it->second.mem_size == mem_size) {
+            return;
+        }
+        ggml_cuda_set_device(it->second.device);
+        CUDA_CHECK(cudaFree(it->second.d_alloc));
+        g_gdn_replay_map.erase(it);
+    }
+
+    const int64_t k_elems    = mem_size * GDN_REPLAY_MAX_T * H_k * S_v;
+    const int64_t v_elems    = mem_size * GDN_REPLAY_MAX_T * H_v * S_v;
+    const int64_t gb_elems   = mem_size * GDN_REPLAY_MAX_T * H_v;
+    const size_t  sz_k       = gdn_align256((size_t) k_elems  * sizeof(float));
+    const size_t  sz_v       = gdn_align256((size_t) v_elems  * sizeof(float));
+    const size_t  sz_g       = gdn_align256((size_t) gb_elems * sizeof(float));
+    const size_t  sz_beta    = gdn_align256((size_t) gb_elems * sizeof(float));
+    const size_t  sz_meta    = gdn_align256((size_t) mem_size * sizeof(gdn_replay_meta));
+    const size_t  total_sz   = sz_k + sz_v + sz_g + sz_beta + sz_meta;
+
+    ggml_cuda_set_device(device);
+    void * d_alloc = nullptr;
+    CUDA_CHECK(cudaMalloc(&d_alloc, total_sz));
+    CUDA_CHECK(cudaMemset(d_alloc, 0, total_sz));
+
+    char * p = (char *) d_alloc;
+    gdn_replay_entry entry{};
+    entry.device     = device;
+    entry.ssm_buffer = ssm_buffer;
+    entry.ssm_base   = ssm_base;
+    entry.D          = S_v * S_v * H_v;
+    entry.S_v        = S_v;
+    entry.H_v        = H_v;
+    entry.H_k        = H_k;
+    entry.mem_size   = mem_size;
+    entry.K_max      = K_max;
+    entry.d_alloc    = d_alloc;
+    entry.d_k        = (float *) p; p += sz_k;
+    entry.d_v        = (float *) p; p += sz_v;
+    entry.d_g        = (float *) p; p += sz_g;
+    entry.d_beta     = (float *) p; p += sz_beta;
+    entry.d_meta     = (gdn_replay_meta *) p;
+
+    g_gdn_replay_map.emplace(ssm_base, entry);
+    g_gdn_replay_active.store(true, std::memory_order_release);
+}
+
+static bool gdn_replay_lookup(const void * ssm_base, gdn_replay_entry & out) {
+    if (!g_gdn_replay_active.load(std::memory_order_acquire)) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_gdn_replay_mtx);
+    auto it = g_gdn_replay_map.find(ssm_base);
+    if (it == g_gdn_replay_map.end()) {
+        return false;
+    }
+    out = it->second;
+    return true;
+}
+
+// Kernel 1: Direct-state GDN with exact FP32 rollback replay from slot 1 (S_v=128, !KDA, n_seqs=1)
+__global__ void __launch_bounds__(128, 2)
+gated_delta_net_replay_cuda(
+        const float * __restrict__ q,
+        const float * __restrict__ k,
+        const float * __restrict__ v,
+        const float * __restrict__ g,
+        const float * __restrict__ beta,
+        float * __restrict__       dst,
+        float * __restrict__       ssm_base,
+        const int32_t * __restrict__ d_s_copy,
+        const float * __restrict__ rep_k,
+        const float * __restrict__ rep_v,
+        const float * __restrict__ rep_g,
+        const float * __restrict__ rep_beta,
+        const gdn_replay_meta * __restrict__ rep_meta,
+        int64_t       H,
+        int64_t       H_k,
+        int64_t       n_tokens,
+        int64_t       mem_size,
+        int64_t       dst_cell,
+        int64_t       sq1,
+        int64_t       sq2,
+        int64_t       sv1,
+        int64_t       sv2,
+        int64_t       sb1,
+        int64_t       sb2,
+        const uint3   neqk1_magic,
+        float         scale) {
+    constexpr int S_v           = 128;
+    constexpr int cols_per_warp = 4;
+    constexpr int lanes_per_col = 8;
+    constexpr int n_vec4        = 4;
+
+    const uint32_t h_idx       = blockIdx.x;
+    const int      lane        = threadIdx.x;
+    const int      col_in_warp = lane / lanes_per_col;
+    const int      lane_in_col = lane - col_in_warp * lanes_per_col;
+    const int      col         = (blockIdx.z * blockDim.y + threadIdx.y) * cols_per_warp + col_in_warp;
+    const uint32_t iq1         = fastmodulo(h_idx, neqk1_magic);
+
+    const int32_t s_copy_val = d_s_copy[0];
+    const int32_t rs_idx     = s_copy_val / (int32_t) mem_size;
+    const int32_t src_cell   = s_copy_val - rs_idx * (int32_t) mem_size;
+
+    const int64_t D       = H * (int64_t)(S_v * S_v);
+    const int64_t col_off = ((int64_t) h_idx * S_v + col) * S_v;
+
+    const gdn_replay_meta meta = rep_meta[src_cell];
+    const bool do_replay = (rs_idx > 0) && (meta.valid != 0) && (rs_idx < meta.prev_n);
+
+    const int64_t load_slot = do_replay ? 1 : (int64_t) rs_idx;
+    const float4 * curr_s4 = reinterpret_cast<const float4 *>(
+        ssm_base + (load_slot * mem_size + src_cell) * D + col_off);
+
+    float4 s4[n_vec4];
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (int r = 0; r < n_vec4; ++r) {
+        s4[r] = curr_s4[r * 8 + lane_in_col];
+    }
+
+    if (do_replay) {
+        const int n_replay = meta.prev_n - rs_idx;
+        const float * rk_base = rep_k    + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H_k * S_v) + (int64_t) iq1 * S_v;
+        const float * rv_base = rep_v    + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H   * S_v) + (int64_t) h_idx * S_v;
+        const float * rg_base = rep_g    + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H) + h_idx;
+        const float * rb_base = rep_beta + (int64_t) src_cell * (GDN_REPLAY_MAX_T * H) + h_idx;
+
+        for (int t = 0; t < n_replay; ++t) {
+            const float4 * k_t4 = reinterpret_cast<const float4 *>(rk_base + (int64_t) t * H_k * S_v);
+            const float *  v_t  = rv_base + (int64_t) t * H * S_v;
+            const float    g_val    = rg_base[(int64_t) t * H];
+            const float    beta_val = rb_base[(int64_t) t * H];
+
+            float4 k4[n_vec4];
+            float kv_shard = 0.0f;
+#pragma unroll
+            for (int r = 0; r < n_vec4; ++r) {
+                k4[r] = k_t4[r * 8 + lane_in_col];
+                kv_shard += s4[r].x * k4[r].x + s4[r].y * k4[r].y + s4[r].z * k4[r].z + s4[r].w * k4[r].w;
+            }
+            const float kv_col    = warp_reduce_sum<lanes_per_col>(kv_shard);
+            const float delta_col = (v_t[col] - g_val * kv_col) * beta_val;
+#pragma unroll
+            for (int r = 0; r < n_vec4; ++r) {
+                s4[r].x = g_val * s4[r].x + k4[r].x * delta_col;
+                s4[r].y = g_val * s4[r].y + k4[r].y * delta_col;
+                s4[r].z = g_val * s4[r].z + k4[r].z * delta_col;
+                s4[r].w = g_val * s4[r].w + k4[r].w * delta_col;
+            }
+        }
+    }
+
+    // Save S_start to slot 1 (streaming store so we don't pollute L2); only needed when n_tokens > 1
+    if (n_tokens > 1) {
+        float4 * slot1_s4 = reinterpret_cast<float4 *>(
+            ssm_base + (1 * mem_size + dst_cell) * D + col_off);
+#pragma unroll
+        for (int r = 0; r < n_vec4; ++r) {
+            __stcs(slot1_s4 + r * 8 + lane_in_col, s4[r]);
+        }
+    }
+
+    float * attn_data = dst + (int64_t) h_idx * S_v;
+    for (int t = 0; t < n_tokens; ++t) {
+        const float4 * q_t4 = reinterpret_cast<const float4 *>(q + t * sq2 + iq1 * sq1);
+        const float4 * k_t4 = reinterpret_cast<const float4 *>(k + t * sq2 + iq1 * sq1);
+        const float *  v_t  = v + t * sv2 + h_idx * sv1;
+        const int64_t  gb_off = t * sb2 + h_idx * sb1;
+        const float    beta_val = beta[gb_off];
+        const float    g_val    = expf(g[gb_off]);
+
+        float4 k4[n_vec4];
+        float4 q4[n_vec4];
+        float kv_shard = 0.0f;
+#pragma unroll
+        for (int r = 0; r < n_vec4; ++r) {
+            k4[r] = k_t4[r * 8 + lane_in_col];
+            q4[r] = q_t4[r * 8 + lane_in_col];
+            kv_shard += s4[r].x * k4[r].x + s4[r].y * k4[r].y + s4[r].z * k4[r].z + s4[r].w * k4[r].w;
+        }
+        const float kv_col    = warp_reduce_sum<lanes_per_col>(kv_shard);
+        const float delta_col = (v_t[col] - g_val * kv_col) * beta_val;
+
+        float attn_partial = 0.0f;
+#pragma unroll
+        for (int r = 0; r < n_vec4; ++r) {
+            s4[r].x = g_val * s4[r].x + k4[r].x * delta_col;
+            s4[r].y = g_val * s4[r].y + k4[r].y * delta_col;
+            s4[r].z = g_val * s4[r].z + k4[r].z * delta_col;
+            s4[r].w = g_val * s4[r].w + k4[r].w * delta_col;
+            attn_partial += s4[r].x * q4[r].x + s4[r].y * q4[r].y + s4[r].z * q4[r].z + s4[r].w * q4[r].w;
+        }
+        const float attn_col = warp_reduce_sum<lanes_per_col>(attn_partial);
+        if (lane_in_col == 0) {
+            attn_data[col] = attn_col * scale;
+        }
+        attn_data += S_v * H;
+    }
+
+    // Save final state S_final to slot 0
+    float4 * slot0_s4 = reinterpret_cast<float4 *>(
+        ssm_base + (0 * mem_size + dst_cell) * D + col_off);
+#pragma unroll
+    for (int r = 0; r < n_vec4; ++r) {
+        slot0_s4[r * 8 + lane_in_col] = s4[r];
+    }
+}
+
+// Kernel 2: Post-GDN save of (k, v, expf(g), beta) into replay buffer + update meta
+__global__ void gdn_save_replay_cuda(
+        const float * __restrict__ k,
+        const float * __restrict__ v,
+        const float * __restrict__ g,
+        const float * __restrict__ beta,
+        float * __restrict__       rep_k,
+        float * __restrict__       rep_v,
+        float * __restrict__       rep_g,
+        float * __restrict__       rep_beta,
+        gdn_replay_meta * __restrict__ rep_meta,
+        int64_t H,
+        int64_t H_k,
+        int64_t n_tokens,
+        int64_t dst_cell,
+        int64_t sq1,
+        int64_t sq2,
+        int64_t sv1,
+        int64_t sv2,
+        int64_t sb1,
+        int64_t sb2) {
+    constexpr int S_v = 128;
+    constexpr int S_v4 = S_v / 4; // 32
+    const int64_t tid = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+
+    if (tid == 0) {
+        rep_meta[dst_cell].valid  = (n_tokens > 1) ? 1 : 0;
+        rep_meta[dst_cell].prev_n = (n_tokens > 1) ? (int32_t) n_tokens : 0;
+    }
+    if (n_tokens <= 1) {
+        return;
+    }
+
+    const int64_t n_k4 = n_tokens * H_k * S_v4;
+    const int64_t n_v4 = n_tokens * H   * S_v4;
+    const int64_t n_gb = n_tokens * H;
+
+    float4 * dst_k4 = reinterpret_cast<float4 *>(rep_k + dst_cell * (GDN_REPLAY_MAX_T * H_k * S_v));
+    float4 * dst_v4 = reinterpret_cast<float4 *>(rep_v + dst_cell * (GDN_REPLAY_MAX_T * H   * S_v));
+    float *  dst_g  = rep_g    + dst_cell * (GDN_REPLAY_MAX_T * H);
+    float *  dst_b  = rep_beta + dst_cell * (GDN_REPLAY_MAX_T * H);
+
+    const int64_t stride = (int64_t) gridDim.x * blockDim.x;
+    for (int64_t idx = tid; idx < n_k4 + n_v4; idx += stride) {
+        if (idx < n_k4) {
+            const int64_t d4 = idx & (S_v4 - 1);
+            const int64_t th = idx >> 5;
+            const int64_t t  = th / H_k;
+            const int64_t hk = th - t * H_k;
+            const float4 * src_k4 = reinterpret_cast<const float4 *>(k + t * sq2 + hk * sq1);
+            dst_k4[idx] = src_k4[d4];
+        } else {
+            const int64_t vi = idx - n_k4;
+            const int64_t d4 = vi & (S_v4 - 1);
+            const int64_t th = vi >> 5;
+            const int64_t t  = th / H;
+            const int64_t hv = th - t * H;
+            const float4 * src_v4 = reinterpret_cast<const float4 *>(v + t * sv2 + hv * sv1);
+            dst_v4[vi] = src_v4[d4];
+        }
+    }
+
+    for (int64_t idx = tid; idx < n_gb; idx += stride) {
+        const int64_t t  = idx / H;
+        const int64_t hv = idx - t * H;
+        const int64_t gb_off = t * sb2 + hv * sb1;
+        dst_g[idx] = expf(g[gb_off]);
+        dst_b[idx] = beta[gb_off];
+    }
+}
+
+// Kernel 3: Resolve starting state s0 into scratch dst_s0 (for prefill n_tokens > GDN_REPLAY_MAX_T)
+__global__ void __launch_bounds__(128, 2)
