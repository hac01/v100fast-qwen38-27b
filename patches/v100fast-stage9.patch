+    const float4 * a4 = reinterpret_cast<const float4 *>(a) + base4;
+    const float4 * b4 = do_add ? (reinterpret_cast<const float4 *>(b) + base4) : nullptr;
+    const float4 * w4 = reinterpret_cast<const float4 *>(w);
+    float4 * add4     = do_add ? (reinterpret_cast<float4 *>(add_dst) + base4) : nullptr;
+    float4 * mul4     = reinterpret_cast<float4 *>(mul_dst) + base4;
+    uint2  * f16_4    = write_f16 ? (reinterpret_cast<uint2 *>(f16_dst) + base4) : nullptr;
+
+    float4 xs[vpt];
+    float tmp = 0.0f;
+
+#pragma unroll
+    for (int k = 0; k < vpt; ++k) {
+        const int i = tid + k * block_size;
+        if (i < ncols4) {
+            float4 v = a4[i];
+            if constexpr (do_add) {
+                const float4 bv = b4[i];
+                v.x += bv.x;
+                v.y += bv.y;
+                v.z += bv.z;
+                v.w += bv.w;
+                add4[i] = v;
+            }
+            xs[k] = v;
+            tmp += v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w;
+        }
+    }
+
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(tmp / (float) ncols + eps);
+
+#pragma unroll
+    for (int k = 0; k < vpt; ++k) {
+        const int i = tid + k * block_size;
+        if (i < ncols4) {
+            const float4 m = w4[i];
+            const float4 r = make_float4(
+                xs[k].x * scale * m.x,
+                xs[k].y * scale * m.y,
+                xs[k].z * scale * m.z,
+                xs[k].w * scale * m.w);
