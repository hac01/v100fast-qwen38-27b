+    half * f16_ptr = write_f16 ? (half *) ctx.f16_act_buf : nullptr;
+    cudaStream_t stream = ctx.stream();
+    constexpr int BS = 1024;
+    const size_t smem = (BS / WARP_SIZE) * sizeof(float);
+
+    auto dispatch_vpt = [&](auto do_add_tag, auto write_f16_tag) {
