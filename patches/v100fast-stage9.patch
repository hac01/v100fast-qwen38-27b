+// Stage 8E-3: Single-pass coalesced direct SSM conv (d_conv=4) + SiLU + rollback conv_state scatter.
+// Eliminates concat_dim0_src1_transposed + intermediate conv_input HBM2 buffer + k_set_rows_chan_coalesced.
+template <int BLOCK_C>
+static __global__ void __launch_bounds__(BLOCK_C)
+ssm_conv_direct_d4_f32_kernel(
+        const float   * __restrict__ conv_state_in, // [3, C] contiguous (stride 3 floats per channel)
+        const float   * __restrict__ qkv_in,        // [C, n_t] contiguous (stride C floats per token)
+        const float   * __restrict__ conv_w,        // [4, C] contiguous (stride 4 floats per channel)
+        const int32_t * __restrict__ slot_order,    // [Kw]
+        float         * __restrict__ slots_out,     // [3, K, C] with slot stride slot_s1, chan stride 3
+        float         * __restrict__ dst_silu,      // [C, n_t] contiguous
+        const int C, const int n_t, const int Kw, const int64_t qkv_s0, const int64_t slot_s1) {
+    const int c0  = blockIdx.x * BLOCK_C;
+    const int tid = threadIdx.x;
+    const int c   = c0 + tid;
+
+    // 1. Coalesced load of conv_state_in[c0..c0+BLOCK_C-1, 0..2] (3 * BLOCK_C floats) via smem
+    //    and conv_w[c0..c0+BLOCK_C-1, 0..3] (4 * BLOCK_C floats) via smem.
+    __shared__ float smem[4 * BLOCK_C];
+
+    const float * cs_blk = conv_state_in + (int64_t) c0 * 3;
+#pragma unroll
+    for (int k = 0; k < 3; ++k) {
+        smem[k * BLOCK_C + tid] = cs_blk[k * BLOCK_C + tid];
+    }
+    __syncthreads();
+    float w0 = smem[tid * 3 + 0];
+    float w1 = smem[tid * 3 + 1];
+    float w2 = smem[tid * 3 + 2];
+    __syncthreads();
+
+    const float * cw_blk = conv_w + (int64_t) c0 * 4;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        smem[k * BLOCK_C + tid] = cw_blk[k * BLOCK_C + tid];
+    }
+    __syncthreads();
+    const float k0 = smem[tid * 4 + 0];
+    const float k1 = smem[tid * 4 + 1];
+    const float k2 = smem[tid * 4 + 2];
+    const float k3 = smem[tid * 4 + 3];
+    __syncthreads();
+
+    const int t_start = n_t - Kw;
+
+    for (int t = 0; t < n_t; ++t) {
+        const float x_t = qkv_in[(int64_t) t * qkv_s0 + c];
+        const float sum = fmaf(w0, k0, fmaf(w1, k1, fmaf(w2, k2, x_t * k3)));
+        dst_silu[(int64_t) t * C + c] = ggml_cuda_op_silu_single(sum);
+
+        w0 = w1;
+        w1 = w2;
+        w2 = x_t;
+
+        if (t >= t_start) {
+            const int64_t dst_row = slot_order[t - t_start];
+            smem[tid * 3 + 0] = w0;
+            smem[tid * 3 + 1] = w1;
+            smem[tid * 3 + 2] = w2;
+            __syncthreads();
+            float * sl_blk = slots_out + dst_row * slot_s1 + (int64_t) c0 * 3;
+#pragma unroll
+            for (int k = 0; k < 3; ++k) {
+                sl_blk[k * BLOCK_C + tid] = smem[k * BLOCK_C + tid];
+            }
+            __syncthreads();
+        }
+    }
+}
