+bool ggml_cuda_op_ssm_conv_direct(ggml_backend_cuda_context & ctx,
+                                  ggml_tensor * concat_node,
+                                  ggml_tensor * set_rows_node,
+                                  ggml_tensor * ssm_conv_node,
+                                  ggml_tensor * silu_node) {
+    const ggml_tensor * conv_states = concat_node->src[0];
+    const ggml_tensor * qkv_t       = concat_node->src[1];
+    const ggml_tensor * windows     = set_rows_node->src[0];
+    const ggml_tensor * slot_order  = set_rows_node->src[1];
+    const ggml_tensor * conv_w      = ssm_conv_node->src[1];
+
+    if (!conv_states || !qkv_t || !windows || !slot_order || !conv_w) { return false; }
+    if (ggml_get_op_params_i32(concat_node, 0) != 0) { return false; }
+
+    // Types
+    if (conv_states->type != GGML_TYPE_F32 || qkv_t->type != GGML_TYPE_F32 ||
+        set_rows_node->type != GGML_TYPE_F32 || slot_order->type != GGML_TYPE_I32 ||
+        conv_w->type != GGML_TYPE_F32 || silu_node->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    // Shapes: d_conv == 4, n_seqs == 1, C % 128 == 0, n_t in [1..64]
+    const int64_t C   = conv_states->ne[1];
+    const int64_t n_t = qkv_t->ne[0];
+    const int64_t Kw  = windows->ne[1];
+    if (conv_states->ne[0] != 3 || conv_states->ne[2] != 1 || conv_states->ne[3] != 1) { return false; }
+    if (qkv_t->ne[1] != C || qkv_t->ne[2] != 1 || qkv_t->ne[3] != 1) { return false; }
+    if (C <= 0 || (C % 128) != 0 || n_t < 1 || n_t > 64) { return false; }
+    if (conv_w->ne[0] != 4 || conv_w->ne[1] != C || !ggml_is_contiguous(conv_w)) { return false; }
+    if (silu_node->ne[0] != C || silu_node->ne[1] != n_t || silu_node->ne[2] != 1 || silu_node->ne[3] != 1 ||
+        !ggml_is_contiguous(silu_node)) {
+        return false;
+    }
+
+    static const bool dbg = getenv("LLAMA_SM70_FUSE_DBG") != nullptr;
+    static int dbg_n = 0;
+    auto fail = [&](int code) {
+        if (dbg && dbg_n++ < 5) {
+            fprintf(stderr, "[8E3-OP] fail=%d C=%lld n_t=%lld Kw=%lld qkv_nb=(%zu,%zu) win_nb=(%zu,%zu,%zu) win_offs=%zu sr_nb=(%zu,%zu,%zu) same_qkv=%d\n",
+                code, (long long)C, (long long)n_t, (long long)Kw,
+                qkv_t->nb[0], qkv_t->nb[1],
+                windows->nb[0], windows->nb[1], windows->nb[2], windows->view_offs,
+                set_rows_node->nb[0], set_rows_node->nb[1], set_rows_node->nb[2],
+                (int)(silu_node->data == qkv_t->data));
+        }
+        return false;
+    };
+
+    // Verify conv_states is contiguous [3, C] and qkv_t has contiguous channels with strided tokens
+    if (!ggml_is_contiguous(conv_states)) { return fail(1); }
+    if (qkv_t->nb[1] != sizeof(float) || (qkv_t->nb[0] % sizeof(float)) != 0 || qkv_t->nb[0] < (size_t) C * sizeof(float)) { return fail(2); }
+    const int64_t qkv_s0 = (int64_t) (qkv_t->nb[0] / sizeof(float));
+
+    // Verify windows view into concat_node matches build_conv_state_store
+    if (windows->view_src != concat_node || windows->ne[0] != 3 || windows->ne[2] != C || windows->ne[3] != 1) {
+        return fail(3);
+    }
+    if (Kw < 1 || Kw > n_t || slot_order->ne[0] != Kw || !ggml_is_contiguous(slot_order)) { return fail(4); }
+    if (windows->nb[0] != sizeof(float) || windows->nb[1] != sizeof(float) ||
+        windows->nb[2] != concat_node->nb[1] ||
+        windows->view_offs != (size_t) (n_t - (Kw - 1)) * sizeof(float)) {
+        return fail(5);
+    }
+
+    // Verify set_rows_node (slots) is channel-coalesced [3, K, C, 1]
+    if (set_rows_node->ne[0] != 3 || set_rows_node->ne[2] != C || set_rows_node->ne[3] != 1) { return fail(6); }
+    if (set_rows_node->nb[0] != sizeof(float) || set_rows_node->nb[2] != 3 * sizeof(float) ||
+        (set_rows_node->nb[1] % sizeof(float)) != 0) {
+        return fail(7);
+    }
+
+    // Output silu_node must not overlap inputs/slots (exact alias silu==qkv when qkv_s0==C is safe: thread reads t before writing t!)
+    const size_t silu_bytes = (size_t) C * (size_t) n_t * sizeof(float);
+    const size_t qkv_bytes  = (size_t) qkv_s0 * (size_t) n_t * sizeof(float);
+    auto ov = [](const void * p1, size_t n1, const void * p2, size_t n2) {
+        const uintptr_t a0 = (uintptr_t) p1, a1 = a0 + n1;
+        const uintptr_t b0 = (uintptr_t) p2, b1 = b0 + n2;
+        return a0 < b1 && b0 < a1;
+    };
+    const bool qkv_exact_ok = (silu_node->data == qkv_t->data && qkv_s0 == C);
+    if ((!qkv_exact_ok && ov(silu_node->data, silu_bytes, qkv_t->data, qkv_bytes)) ||
+        ov(silu_node->data, silu_bytes, conv_states->data, (size_t) C * 3 * sizeof(float)) ||
+        ov(silu_node->data, silu_bytes, conv_w->data, (size_t) C * 4 * sizeof(float))) {
+        return fail(8);
+    }
+
+    const int64_t slot_s1 = (int64_t) (set_rows_node->nb[1] / sizeof(float));
+    constexpr int BLOCK_C = 128;
+    const dim3 grid((uint32_t) (C / BLOCK_C), 1, 1);
+    ssm_conv_direct_d4_f32_kernel<BLOCK_C><<<grid, BLOCK_C, 0, ctx.stream()>>>(
+        (const float *) conv_states->data,
+        (const float *) qkv_t->data,
+        (const float *) conv_w->data,
+        (const int32_t *) slot_order->data,
+        (float *) set_rows_node->data,
+        (float *) silu_node->data,
+        (int) C, (int) n_t, (int) Kw, qkv_s0, slot_s1);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
