+// Bit-exact with quantize_f32_q8_0_block, achieves full coalescing and 32x higher SM occupancy for small KV stores.
+template <typename src_t, typename idx_t>
+static __global__ void __launch_bounds__(128)
+k_set_rows_q8_0_warp(const src_t * __restrict__ src0,
+                     const idx_t * __restrict__ src1,
+                     block_q8_0 * __restrict__  dst,
+                     const int64_t ne_total,
+                     const int64_t s01,
+                     const int64_t s02,
+                     const int64_t s03,
+                     const int64_t s10,
+                     const int64_t s11,
+                     const int64_t s12,
+                     const int64_t s1,
+                     const int64_t s2,
+                     const int64_t s3,
+                     const uint3   ne00_blks_fd,
+                     const uint3   ne01_fd,
+                     const uint3   ne02_fd,
+                     const uint3   ne11_fd,
+                     const uint3   ne12_fd) {
