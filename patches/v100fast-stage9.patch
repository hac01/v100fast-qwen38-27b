+template <int block_size, int vpt, bool do_add, bool write_f16>
+static __global__ void __launch_bounds__(block_size)
+add_rms_norm_mul_f32_f16_kernel(
+        const float * __restrict__ a,
+        const float * __restrict__ b,
+        const float * __restrict__ w,
+        float       * __restrict__ add_dst,
+        float       * __restrict__ mul_dst,
+        half        * __restrict__ f16_dst,
+        const int ncols,
+        const float eps) {
+    const int row    = blockIdx.x;
+    const int tid    = threadIdx.x;
+    const int ncols4 = ncols >> 2;
+    const int base4  = row * ncols4;
