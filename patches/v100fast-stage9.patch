+        } else {
+            add_rms_norm_mul_f32_f16_kernel<BS, 4, DA, WF><<<(uint32_t) nrows, BS, smem, stream>>>(
+                a, b, w, add_dst, mul_dst, f16_ptr, (int) ncols, eps);
+        }
+    };
+
+    if (do_add) {
+        if (write_f16) dispatch_vpt(std::true_type{},  std::true_type{});
+        else           dispatch_vpt(std::true_type{},  std::false_type{});
+    } else {
+        if (write_f16) dispatch_vpt(std::false_type{}, std::true_type{});
+        else           dispatch_vpt(std::false_type{}, std::false_type{});
